# Diese Datei wird von Vercel beim Import ausgelesen. Hier stehen deshalb
# ausschliesslich Variablen, die auch auf Vercel gesetzt werden muessen.
#
# Werte aus: Supabase -> Project Settings -> API Keys
# Die neuen Schluessel (sb_publishable_... / sb_secret_...) ersetzen die alten
# anon- und service_role-Keys, die Supabase bis Ende 2026 abschaltet.

# Supabase-Projekt in eu-central-2 (Zuerich) - ADR-005
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur serverseitig, in Vercel als "Sensitive" markieren.
# Umgeht RLS vollstaendig - ausschliesslich in src/lib/supabase/admin.ts
# verwenden (Regel R3).
SUPABASE_SECRET_KEY=
